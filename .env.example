# Meta Model API key (dev.meta.ai). Leave empty to run on stand-ins.
MODEL_API_KEY=
# Force the stand-ins even with a key: 1
CUEON_FAKE=
# Local mode: write cards with Muse Glimmer on this machine (spark | glimmer)
MODEL_BACKEND=spark
LOCAL_BASE_URL=http://localhost:8080/v1
LOCAL_MODEL=muse-glimmer-30b
